# Base de datos Postgres (local con Docker, Railway, Neon, Supabase, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consultor_rama?schema=public"

# Secreto para firmar la cookie de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Secreto que protege el endpoint de cron /api/cron/refresh.
# El scheduler debe mandar el header:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET="cambia-esto-tambien"

# Base del API publico de la Rama Judicial (CPNU). Ojo al puerto :448.
RAMA_API_BASE="https://consultaprocesos.ramajudicial.gov.co:448/api/v2"

# URL publica de la app (para los enlaces en los correos).
APP_URL="http://localhost:3000"

# SMTP para notificar actuaciones nuevas. Si lo dejas vacio, los correos solo
# se registran en consola (modo desarrollo). Ejemplo con un proveedor SMTP:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Consultor de Procesos <no-reply@tudominio.com>"

# Notificaciones push (Web Push). Genera un par con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La PUBLIC va también al cliente (debe empezar con NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notificaciones@tudominio.com"

# Pagos con Bold (bold.co → Integraciones → Llaves de integración → Botón de pagos).
# Llave de identidad: crea y consulta los links de pago.
BOLD_API_KEY=""
# Llave secreta: valida la firma de los webhooks (Integraciones → Webhooks →
# URL: https://TU_DOMINIO/api/bold/webhook).
BOLD_SECRET_KEY=""

# --- Sincronización nocturna (opcionales; valores por defecto entre paréntesis) ---
# SYNC_CONCURRENCY=2          # consultas a la Rama a la vez (2)
# SYNC_PAUSE_MIN_MS=1500      # pausa aleatoria entre consultas (1500-3000 ms)
# SYNC_PAUSE_MAX_MS=3000
# SYNC_BUDGET_MS=240000       # tiempo de trabajo por corrida de 5 min (4 min)
# SMTP_RATE_PER_SEC=5         # correos por segundo como máximo

# --- Proxy para la Rama (apagado por defecto) ---
# USE_PROXY=false
# PROXY_URL=http://usuario:clave@proxy:puerto
# PROXY_URL=https://api.scraperapi.com/?api_key=XXX&url={url}

# --- Límite general de consultas a la Rama (toda la plataforma) ---
# RAMA_MAX_CONCURRENT=4       # consultas simultáneas como máximo (4)
# RAMA_MIN_GAP_MS=250         # espacio mínimo entre consultas (250 ms)

# --- Continuar con Google (OAuth) ---
# Retorno autorizado en Google Cloud: https://app.estradox.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
